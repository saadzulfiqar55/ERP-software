# JWT Session Secret (HS256) — REQUIRED in production, at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Super Admin bootstrap login — REQUIRED on a fresh install (no default password ships in source).
# After first sign-in, change the password in Settings; the stored hash then replaces this override.
# ADMIN_USERNAME="saad"
# ADMIN_PASSWORD="your_strong_super_admin_password"

# PostgreSQL — REQUIRED. It is the only data store (there is no local JSON fallback).
# Use a separate database for development; never point local dev at production.
# Supabase: use the Transaction Pooler (port 6543).
# Migrating old local data: node --env-file=.env.local scripts/import-legacy-json.mjs  (dry run; add --apply)
DATABASE_URL="postgresql://postgres.vnekmhvwkalwuyxhvyqq:[YOUR-DATABASE-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres"

# StackLyra Multi-Tenant SaaS Domain & CORS Configuration
NEXT_PUBLIC_APP_URL="https://erp.stacklyra.com"
NEXT_PUBLIC_MARKETING_URL="https://stacklyra.com"
COOKIE_DOMAIN=""
ALLOWED_CORS_ORIGINS="https://stacklyra.com,https://www.stacklyra.com,https://app.stacklyra.com,https://erp.stacklyra.com,http://localhost:3000"
# Billing webhook HMAC key — REQUIRED for /api/saas/webhooks/billing (disabled when empty).
# Senders must set X-StackLyra-Timestamp (unix seconds) and
# X-StackLyra-Signature = hex(HMAC-SHA256(secret, `${timestamp}.${rawBody}`)).
BILLING_WEBHOOK_SECRET=""
